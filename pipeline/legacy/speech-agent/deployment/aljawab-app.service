[Unit]
Description=Aljawab bilingual voice application
After=network-online.target aljawab-livekit.service
Requires=aljawab-livekit.service
[Service]
User=ubuntu
WorkingDirectory=/opt/dlami/nvme/speech-agent
ExecStart=/usr/bin/screen -D -m -S speech-agent -c /opt/dlami/nvme/speech-agent/deployment/app.screenrc -L -Logfile /opt/dlami/nvme/speech-agent/logs/app.log /opt/dlami/nvme/speech-agent/scripts/run_app.sh
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
UMask=0077
StandardOutput=append:/opt/dlami/nvme/speech-agent/logs/app.log
StandardError=append:/opt/dlami/nvme/speech-agent/logs/app.log
[Install]
WantedBy=multi-user.target
