[Unit]
Description=Renew Aljawab TURN IP certificate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/dlami/nvme/speech-agent
ExecStart=/opt/dlami/nvme/speech-agent/.acme-venv/bin/certbot renew --non-interactive --config-dir /etc/letsencrypt-aljawab --work-dir /var/lib/letsencrypt-aljawab --logs-dir /var/log/letsencrypt-aljawab --deploy-hook "/bin/bash /opt/dlami/nvme/speech-agent/scripts/deploy_turn_certificate.sh"
UMask=0077
