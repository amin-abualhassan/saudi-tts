[Unit]
Description=Aljawab TURN TLS certificate terminator
After=network-online.target aljawab-livekit.service
Wants=network-online.target aljawab-livekit.service

[Service]
Type=notify
ExecStartPre=/usr/sbin/haproxy -c -f /opt/dlami/nvme/speech-agent/deployment/turn-proxy.cfg
ExecStart=/usr/sbin/haproxy -Ws -f /opt/dlami/nvme/speech-agent/deployment/turn-proxy.cfg -p /run/aljawab-turn-proxy.pid
ExecReload=/usr/sbin/haproxy -c -f /opt/dlami/nvme/speech-agent/deployment/turn-proxy.cfg
ExecReload=/bin/kill -USR2 $MAINPID
KillMode=mixed
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
